# Copie este arquivo para .env (ou configure as variaveis no ambiente
# do Render) e ajuste os valores antes de rodar a aplicacao.

# URL JDBC do PostgreSQL (Aiven). Ex.:
# jdbc:postgresql://host-do-banco.aivencloud.com:PORT/dbname?sslmode=require
DB_URL=jdbc:postgresql://SEU_HOST_AIVEN:PORT/SEU_BANCO?sslmode=require
DB_USER=seu-usuario
DB_PASSWORD=sua-senha

# Porta HTTP (o Render injeta PORT automaticamente; 8080 e o fallback local)
PORT=8080

# Segredo usado para assinar os tokens JWT (minimo 32 caracteres).
# Gere um valor forte, ex.: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-uma-chave-aleatoria-longa

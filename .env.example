# Copie este arquivo para .env (ou exporte as variaveis no ambiente)
# e ajuste os valores antes de rodar a aplicacao.

# Senha do usuario root do MySQL local
MINHA_SENHA=sua-senha-do-mysql

# Segredo usado para assinar os tokens JWT (minimo 32 caracteres).
# Gere um valor forte, ex.: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-uma-chave-aleatoria-longa
